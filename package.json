{
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./resources/css/portal.css -o ./public/assets/portal.css --minify",
    "build:js": "esbuild resources/js/portal.js resources/js/i18n.js resources/js/qr.js --minify --target=es2020 --legal-comments=none --outdir=public/assets",
    "watch:css": "tailwindcss -i ./resources/css/portal.css -o ./public/assets/portal.css --watch",
    "watch:js": "esbuild resources/js/portal.js resources/js/i18n.js resources/js/qr.js --target=es2020 --outdir=public/assets --watch",
    "format": "prettier --write resources/js eslint.config.js playwright.config.js e2e",
    "format:check": "prettier --check resources/js eslint.config.js playwright.config.js e2e",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0"
  },
  "type": "module"
}
